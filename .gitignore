# ===================================================
# STM32H750 BaseFramework - .gitignore
# STM32CubeMX + Keil MDK-ARM + FreeRTOS 项目
# ===================================================

# === Keil MDK-ARM 构建产物 ===
*.o
*.d
*.crf
*.dep
*.htm
*.build_log.htm
*.axf
*.hex
*.bin
*.elf
*.map
*.iex
*.sct
*.lnp
*.plg
*.tra
*.Administrator
*.scvd

# Listing files (汇编器生成，除 startup 外全部忽略)
*.lst
!Drivers/CMSIS/Device/ST/STM32H7xx/Source/Templates/arm/*.s

# 编译输出日志
MDK-ARM/build_output.txt

# === Keil MDK-ARM CubeMX 生成（不跟踪） ===
# RTE 组件（CubeMX 自动生成）
MDK-ARM/RTE/

# Debug 配置（CubeMX 自动生成）
MDK-ARM/DebugConfig/

# CubeMX 项目脚本（自动生成，含绝对路径）
.mxproject

# === Keil MDK-ARM 用户特定文件 ===
*.uvguix.*
*.uvguix

# J-Link 设置文件（含用户路径）
JLinkSettings.ini
*.jlink

# === Debug 配置 ===
DebugConfig/*.dbgconf

# === .claude 本地配置 ===
.claude/

# === CodeGraph 本地索引数据库 ===
.codegraph/

# === Jujutsu (jj) 版本控制本地数据 ===
.jj/

# === 编辑器 / IDE ===
*.swp
*.swo
*~
.vs/
.vscode/
.idea/

# === 操作系统杂项 ===
# Windows
Thumbs.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# === 固件烧录工具杂项 ===
*.bin.crc
*.Settings

# ===================================================
# 说明
# ===================================================
# .uvprojx   — 跟踪，这是项目文件
# .uvoptx    — 跟踪，包含项目选项
# .ioc       — 跟踪，CubeMX 项目配置
# ===================================================
